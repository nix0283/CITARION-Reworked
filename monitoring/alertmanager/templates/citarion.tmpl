{{/* 
  Custom templates for CITARION Alertmanager notifications
  Usage: Reference in alertmanager.yml receivers with `message: {{ template "telegram.citarion.message" . }}`
*/}}

{{ define "telegram.citarion.message" }}
{{- $isCritical := eq .CommonLabels.severity "critical" -}}
{{- $emoji := if $isCritical }}🔴{{ else if eq .CommonLabels.severity "warning" }}🟡{{ else }}🔵{{ end -}}

*{{ $emoji }} {{ .CommonLabels.alertname }}*

{{- if .CommonLabels.severity }}
*Severity:* \_{{ .CommonLabels.severity }}\_
{{- end }}
{{- if .CommonLabels.service }}
*Service:* `{{ .CommonLabels.service }}`
{{- end }}
{{- if .CommonLabels.instance }}
*Instance:* `{{ .CommonLabels.instance }}`
{{- end }}
{{- if .CommonLabels.exchange }}
*Exchange:* `{{ .CommonLabels.exchange }}`
{{- end }}
{{- if .CommonLabels.symbol }}
*Symbol:* `{{ .CommonLabels.symbol }}`
{{- end }}

{{ range .Alerts }}
{{- if gt (len $.Alerts) 1 }}
\\*{{ add1 .Index }}\\*\\. 
{{- end }}
{{ .Annotations.summary | default .Annotations.description | escapeMarkdownV2 }}
{{- if .Annotations.runbook_url }}
[View Runbook]({{ .Annotations.runbook_url }})
{{- end }}
{{ end }}

{{- if .CommonAnnotations.grafana_url }}
[📊 View Dashboard]({{ .CommonAnnotations.grafana_url }})
{{- end }}

_Environment: {{ .CommonLabels.environment | default "unknown" }}_
_Triggered: {{ .StartsAt.Format "2006-01-02 15:04:05" }}_
{{- end }}

{{/* Escape text for Telegram MarkdownV2 */}}
{{ define "escapeMarkdownV2" }}
{{- $text := . -}}
{{- $text = replace $text "_" "\\_" -}}
{{- $text = replace $text "*" "\\*" -}}
{{- $text = replace $text "[" "\\[" -}}
{{- $text = replace $text "]" "\\]" -}}
{{- $text = replace $text "(" "\\(" -}}
{{- $text = replace $text ")" "\\)" -}}
{{- $text = replace $text "~" "\\~" -}}
{{- $text = replace $text "`" "\\`" -}}
{{- $text = replace $text ">" "\\>" -}}
{{- $text = replace $text "#" "\\#" -}}
{{- $text = replace $text "+" "\\+" -}}
{{- $text = replace $text "-" "\\-" -}}
{{- $text = replace $text "=" "\\=" -}}
{{- $text = replace $text "|" "\\|" -}}
{{- $text = replace $text "{" "\\{" -}}
{{- $text = replace $text "}" "\\}" -}}
{{- $text = replace $text "." "\\." -}}
{{- $text = replace $text "!" "\\!" -}}
{{- $text -}}
{{ end }}

{{/* Slack message template */}}
{{ define "slack.citarion.message" }}
{
  "text": "{{ if eq .CommonLabels.severity \"critical\" }}🔴{{ else }}🟡{{ end }} {{ .CommonLabels.alertname }}",
  "blocks": [
    {
      "type": "header",
      "text": {
        "type": "plain_text",
        "text": "{{ if eq .CommonLabels.severity \"critical\" }}🔴{{ else }}🟡{{ end }} {{ .CommonLabels.alertname }}",
        "emoji": true
      }
    },
    {
      "type": "section",
      "fields": [
        {{- if .CommonLabels.severity }}
        { "type": "mrkdwn", "text": "*Severity:* {{ .CommonLabels.severity | upper }}" },
        {{- end }}
        {{- if .CommonLabels.service }}
        { "type": "mrkdwn", "text": "*Service:* `{{ .CommonLabels.service }}`" },
        {{- end }}
        {{- if .CommonLabels.instance }}
        { "type": "mrkdwn", "text": "*Instance:* `{{ .CommonLabels.instance }}`" }
        {{- end }}
      ]
    },
    {{- range .Alerts }}
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": {{ if gt (len $.Alerts) 1 }}"*Alert {{ add1 .Index }}:* " {{ end }}"{{ .Annotations.description | default .Annotations.summary }}"
      }
    }
    {{- if .Annotations.runbook_url }}
    ,{
      "type": "context",
      "elements": [{
        "type": "mrkdwn",
        "text": "<{{ .Annotations.runbook_url }}|📖 View Runbook>"
      }]
    }
    {{- end }}
    {{- end }}
    {{- if .CommonAnnotations.grafana_url }}
    ,{
      "type": "actions",
      "elements": [{
        "type": "button",
        "text": { "type": "plain_text", "text": "📊 View Dashboard", "emoji": true },
        "url": "{{ .CommonAnnotations.grafana_url }}",
        "action_id": "view_dashboard"
      }]
    }
    {{- end }}
  ],
  "attachments": [{
    "color": "{{ if eq .CommonLabels.severity \"critical\" }}danger{{ else if eq .CommonLabels.severity \"warning\" }}warning{{ else }}#36a64f{{ end }}",
    "footer": "Environment: {{ .CommonLabels.environment | default \"unknown\" }} | Triggered: <!date^{{ .StartsAt.Unix }}^{date} {time}|{{ .StartsAt }}>"
  }]
}
{{ end }}

{{/* Email HTML template */}}
{{ define "email.citarion.message" }}
<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 20px; }
    .header { background: {{ if eq .CommonLabels.severity "critical" }}#dc3545{{ else }}#ffc107{{ end }}; color: white; padding: 16px; border-radius: 4px 4px 0 0; }
    .header h2 { margin: 0; }
    .content { padding: 16px; border: 1px solid #ddd; border-top: none; border-radius: 0 0 4px 4px; }
    .label { font-weight: 600; color: #666; }
    .value { font-family: monospace; background: #f5f5f5; padding: 2px 6px; border-radius: 3px; }
    .alert { margin: 12px 0; padding: 12px; background: #f8f9fa; border-left: 4px solid {{ if eq .CommonLabels.severity "critical" }}#dc3545{{ else }}#ffc107{{ end }}; border-radius: 0 4px 4px 0; }
    .footer { margin-top: 24px; padding-top: 16px; border-top: 1px solid #eee; font-size: 12px; color: #666; }
    .button { display: inline-block; padding: 8px 16px; background: {{ if eq .CommonLabels.severity "critical" }}#dc3545{{ else }}#ffc107{{ end }}; color: white; text-decoration: none; border-radius: 4px; margin: 4px 0; }
  </style>
</head>
<body>
  <div class="header">
    <h2>{{ if eq .CommonLabels.severity "critical" }}🔴{{ else }}⚠️{{ end }} {{ .CommonLabels.alertname }}</h2>
  </div>
  <div class="content">
    <p>
      {{- if .CommonLabels.severity }}<span class="label">Severity:</span> <span class="value">{{ .CommonLabels.severity | upper }}</span> {{ end -}}
      {{- if .CommonLabels.service }}<span class="label">Service:</span> <span class="value">{{ .CommonLabels.service }}</span> {{ end -}}
      {{- if .CommonLabels.instance }}<span class="label">Instance:</span> <span class="value">{{ .CommonLabels.instance }}</span>{{ end }}
    </p>
    
    {{- range .Alerts }}
    <div class="alert">
      {{- if gt (len $.Alerts) 1 }}<strong>Alert {{ add1 .Index }}:</strong><br>{{ end }}
      <p>{{ .Annotations.description | default .Annotations.summary }}</p>
      {{- if .Annotations.runbook_url }}
      <a href="{{ .Annotations.runbook_url }}" class="button">📖 View Runbook</a>
      {{- end }}
    </div>
    {{- end }}
    
    <div class="footer">
      <p>
        <strong>Environment:</strong> {{ .CommonLabels.environment | default "unknown" }}<br>
        <strong>Triggered:</strong> {{ .StartsAt.Format "2006-01-02 15:04:05" }}<br>
        {{- if .CommonAnnotations.grafana_url }}
        <a href="{{ .CommonAnnotations.grafana_url }}" class="button">📊 View Dashboard</a>
        {{- end }}
      </p>
    </div>
  </div>
</body>
</html>
{{ end }}
